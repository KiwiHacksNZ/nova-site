---
import type { City } from "../data/cities";

interface Props {
  city: City;
}

const { city } = Astro.props;

const guides = [
  {
    href: city.guides.attendee,
    title: "Attendee guide",
    who: "For students coming along",
    blurb: `The ${city.name} schedule, venue, and how the 24 hours actually run. Read this before you turn up.`,
    format: "PDF, opens in a new tab",
  },
  {
    href: city.guides.parents,
    title: "Parent's guide",
    who: "For parents and caregivers",
    blurb:
      "Cost, supervision, sleeping, food, safety, drop-off and pick-up times, and the full packing list.",
    format: "Google Doc, opens in a new tab",
  },
];
---

<section class="w-full" aria-labelledby="guides-heading">
  <h2
    id="guides-heading"
    class="text-center text-4xl font-semibold text-white sm:text-5xl"
  >
    Guides for {city.name}
  </h2>
  <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-white/80">
    Everything you and your family need to know before the weekend.
  </p>

  <div class="mt-8 grid gap-5 text-left sm:grid-cols-2">
    {
      guides.map((guide) => (
        <a
          href={guide.href}
          target="_blank"
          rel="noopener"
          class="group flex flex-col rounded-2xl bg-[#5c2a42]/85 p-6 no-underline ring-1 ring-white/10 transition-transform hover:-translate-y-1"
        >
          <span class="text-xs font-semibold uppercase tracking-wide text-white/60">
            {guide.who}
          </span>
          <span class="mt-2 flex items-center gap-2 text-2xl font-semibold text-[#ff7ab3]">
            {guide.title}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="h-5 w-5 shrink-0 transition-transform group-hover:translate-y-0.5"
              aria-hidden="true"
            >
              <path
                d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="mt-3 text-base leading-relaxed text-white/80">
            {guide.blurb}
          </span>
          <span class="mt-4 text-sm text-white/55">{guide.format}</span>
        </a>
      ))
    }
  </div>
</section>
