---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import { DEFAULT_DESCRIPTION, SITE_NAME, SITE_URL } from "../data/site";

type JsonLd = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  jsonLd?: JsonLd | JsonLd[];
}

const {
  title = "KiwiHacks Nova | Free 24-hour hackathons for high school students in New Zealand",
  description = DEFAULT_DESCRIPTION,
  ogImage = "/nova-logo.png",
  canonicalPath = Astro.url.pathname,
  jsonLd = [],
} = Astro.props;

const normalizedCanonicalPath =
  canonicalPath === "/" ? "/" : canonicalPath.replace(/\/+$/, "");
const canonicalURL = new URL(normalizedCanonicalPath, Astro.site ?? SITE_URL);
const socialImageURL = new URL(ogImage, Astro.site ?? SITE_URL);
const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const safeJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": schemas,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-NZ" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/nova-logo.png" />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#0a0d28" />
    <meta name="author" content="KiwiHacks" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:alt" content="KiwiHacks Nova logo" />
    <meta property="og:image:width" content="496" />
    <meta property="og:image:height" content="272" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />
    <meta name="twitter:image:alt" content="KiwiHacks Nova logo" />
    {
      schemas.length > 0 && (
        <script type="application/ld+json" set:html={safeJsonLd} />
      )
    }
  </head>
  <body class="flex min-h-full flex-col">
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
