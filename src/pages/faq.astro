---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import NovaLogo from "../components/NovaLogo.astro";
import BackButton from "../components/BackButton.astro";
import FaqSection from "../components/FaqSection.astro";
import { SITE_URL } from "../data/site";
import { breadcrumbSchema } from "../data/structuredData";
import { FAQ_ITEMS, faqSchema } from "../data/faq";

const url = `${SITE_URL}/faq`;
---

<Layout
  title="KiwiHacks Nova FAQ | Cost, eligibility, safety, and what to bring"
  description="Answers about KiwiHacks Nova: who can attend, cost, beginner support, safety, what to bring, what students can build, and how to contact us."
  jsonLd={[
    faqSchema(FAQ_ITEMS, url),
    breadcrumbSchema([
      { name: "KiwiHacks Nova", url: SITE_URL },
      { name: "FAQ", url: `${SITE_URL}/faq` },
    ]),
  ]}
>
  <div class="mx-auto max-w-5xl px-5 pt-6 pb-24">
    <BackButton />

    {/* Logo + FAQ heading */}
    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-6 sm:justify-start"
    >
      <div class="flex flex-col items-center">
        <NovaLogo class="h-20 sm:h-28" />
      </div>
      <h1 class="text-5xl font-semibold text-white sm:text-7xl">FAQ</h1>
    </div>

    <FaqSection items={FAQ_ITEMS} showHeading={false} class="mt-12" />

    <p class="mt-10 text-center text-base text-white/75">
      Looking for venue, schedule, or drop-off times? Those live on your city
      page, along with the attendee and parent guides.
    </p>
  </div>
</Layout>
